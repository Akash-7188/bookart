# ---------------------------------------------------------------------------
# Bookart environment variables
#
# The demo build needs NONE of these — it self-seeds a JSON store in .data/.
# Copy to .env.local only when wiring up the production services.
# ---------------------------------------------------------------------------

# --- Postgres / Supabase (see supabase/schema.sql, prisma/schema.prisma) ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/bookart?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/bookart"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth (NextAuth.js / Auth.js) ------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth 2.0 — console.cloud.google.com → Credentials → OAuth client ID
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments & escrow (deposit capture + refund release) ------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Media (listing photos: front, back, spine, sample page) ---------------
S3_BUCKET="bookart-listings"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments policy knobs (mirrors src/lib/rental.ts) ---------------------
NEXT_PUBLIC_DEFAULT_RADIUS_KM="25"
NEXT_PUBLIC_COURIER_FEE="49"
NEXT_PUBLIC_MAX_SALE_COMMISSION="0.05"
NEXT_PUBLIC_MAX_RENTAL_COMMISSION="0.12"

# --- Cron / background jobs ------------------------------------------------
CRON_SECRET=""
